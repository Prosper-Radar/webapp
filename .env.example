# App runtime (Supabase pooler ok — use sslmode=require in URL if needed)
DATABASE_URL=postgresql://user:password@db.example.supabase.co:6543/postgres?pgbouncer=true
# Optional: direct/session connection for drizzle-kit push/migrate (port 5432)
DIRECT_URL=postgresql://user:password@db.example.supabase.co:5432/postgres

# Schema changes: `npm run db:generate` then `npm run db:migrate`
# (drizzle-kit push can crash on some Supabase/PostGIS introspection — prefer migrate)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-min-32-chars

NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# Open-Meteo météo (sans clé) — utilisé via /api/weather
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional server-only override (same value ok for local)
DEALSCOUT_API_URL=http://localhost:8000

JAY_EMAIL=jay@prospergroup.com
JAY_PASSWORD_HASH=
RAFFAELE_EMAIL=raffaele@prospergroup.com
RAFFAELE_PASSWORD_HASH=
